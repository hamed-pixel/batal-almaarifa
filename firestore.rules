rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    // المسؤولون: يُضافون يدويًا من لوحة Firebase
    match /admins/{uid} { allow read: if isMe(uid); allow write: if false; }

    // ملف الطالب: يقرؤه ويعدّله صاحبه، والمسؤول يرى الجميع
    match /users/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create, update: if isMe(uid) || isAdmin();
      allow delete: if isAdmin();
      match /activity/{id} {
        allow create: if isMe(uid);
        allow read: if isMe(uid) || isAdmin();
        allow update, delete: if isAdmin();
      }
    }

    // لوحة الأبطال: الاسم والصف والنقاط فقط
    // كل طالب يقرأ أبطال مجموعته فقط
    match /leaderboard/{uid} {
      allow read: if isAdmin() || (signedIn() && resource.data.group == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.group);
      allow write: if isMe(uid) || isAdmin();
    }

    // المجموعات: الاسم والإعلان يُقرآن من رابط التسجيل، ويعدّلها المسؤول فقط
    match /groups/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // الأسئلة: يقرؤها كل من سجّل، ويعدّلها المسؤول فقط
    match /questions/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
